<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studysphere.javafx.controller.NotesViewerController" style="-fx-background-color: #0b1120;">

    <!-- Sidebar -->
    <VBox prefWidth="220" spacing="4" styleClass="sidebar">
        <Label text="StudySphere" styleClass="brand-title"/>
        <Label text="Learning Platform" styleClass="brand-subtitle"/>
        <Button text="📊  Dashboard" styleClass="nav-button" maxWidth="Infinity" onAction="#handleBackToDashboard"/>
        <Button text="📤  Upload Material" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToUpload"/>
        <Button text="📝  View Notes" styleClass="nav-button-active,nav-button" maxWidth="Infinity"/>
        <Button text="💬  Ask My Notes" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToAskNotes"/>
        <Button text="🔄  Revision" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToRevision"/>
        <Button text="🎓  CSE1007 Demo" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToCSE1007"/>
        <Button text="⚙  Settings" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToSettings"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Button text="🚪  Logout" styleClass="nav-button" maxWidth="Infinity" onAction="#handleLogout"/>
    </VBox>

    <!-- Content -->
    <VBox HBox.hgrow="ALWAYS" spacing="0">
        <!-- Top Bar -->
        <HBox styleClass="topbar" spacing="16" alignment="CENTER_LEFT">
            <VBox>
                <Label text="Academic Notes Viewer" styleClass="screen-title"/>
                <Label text="Browse topics, summaries, definitions, and keywords" styleClass="screen-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="documentSelector" promptText="Select Document" prefWidth="260"/>
            <TextField fx:id="searchField" promptText="🔍 Search topics..." prefWidth="200"/>
        </HBox>

        <!-- Main Content: Tree + Details -->
        <HBox VBox.vgrow="ALWAYS" spacing="0">
            <!-- Left: Topic Tree -->
            <VBox prefWidth="280" spacing="8" style="-fx-background-color: #0f172a; -fx-padding: 12;">
                <Label text="Topic Hierarchy" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                <TreeView fx:id="topicTree" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Right: Topic Details -->
            <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="16" style="-fx-padding: 24;">
                    <!-- Topic Title + Badges -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label fx:id="topicTitleLabel" text="Select a topic" styleClass="screen-title"/>
                        <Label fx:id="priorityBadge" text="" styleClass="badge-medium"/>
                        <Label fx:id="revisionBadge" text="" styleClass="badge-mastered"/>
                    </HBox>

                    <!-- Summary -->
                    <VBox styleClass="card" spacing="8">
                        <Label text="Summary" styleClass="card-title"/>
                        <TextArea fx:id="summaryArea" wrapText="true" editable="false" prefRowCount="6"
                                  style="-fx-control-inner-background: #0f172a;"/>
                    </VBox>

                    <!-- Important Points -->
                    <VBox styleClass="card" spacing="6">
                        <Label text="Key Takeaways" styleClass="card-title"/>
                        <VBox fx:id="importantPointsBox" spacing="4"/>
                    </VBox>

                    <!-- Definitions -->
                    <VBox styleClass="card" spacing="6">
                        <Label text="Definitions" styleClass="card-title"/>
                        <VBox fx:id="definitionsBox" spacing="6"/>
                    </VBox>

                    <!-- Formulas -->
                    <VBox styleClass="card" spacing="6">
                        <Label text="Formulas &amp; Equations" styleClass="card-title"/>
                        <VBox fx:id="formulasBox" spacing="6"/>
                    </VBox>

                    <!-- Keywords -->
                    <VBox styleClass="card" spacing="8">
                        <Label text="Keywords" styleClass="card-title"/>
                        <FlowPane fx:id="keywordsPane" hgap="8" vgap="8"/>
                    </VBox>

                    <!-- Action Buttons -->
                    <HBox spacing="12">
                        <Button fx:id="markRevisedButton" text="✅ Mark as Revised" onAction="#handleMarkAsRevised" styleClass="btn-success"/>
                        <Button fx:id="takeQuizButton" text="📝 Take Quiz" onAction="#handleTakeQuiz" styleClass="btn-primary"/>
                        <Button fx:id="copyNotesButton" text="📋 Copy Notes" onAction="#handleCopyNotes" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </HBox>
    </VBox>
</HBox>
