<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studysphere.javafx.controller.RevisionController" style="-fx-background-color: #0b1120;">

    <!-- Sidebar -->
    <VBox prefWidth="220" spacing="4" styleClass="sidebar">
        <Label text="StudySphere" styleClass="brand-title"/>
        <Label text="Learning Platform" styleClass="brand-subtitle"/>
        <Button text="📊  Dashboard" styleClass="nav-button" maxWidth="Infinity" onAction="#handleBackToDashboard"/>
        <Button text="📤  Upload Material" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToUpload"/>
        <Button text="📝  View Notes" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToNotes"/>
        <Button text="💬  Ask My Notes" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToAskNotes"/>
        <Button text="🔄  Revision" styleClass="nav-button-active,nav-button" maxWidth="Infinity"/>
        <Button text="🎓  CSE1007 Demo" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToCSE1007"/>
        <Button text="⚙  Settings" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToSettings"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Button text="🚪  Logout" styleClass="nav-button" maxWidth="Infinity" onAction="#handleLogout"/>
    </VBox>

    <!-- Content -->
    <VBox HBox.hgrow="ALWAYS" spacing="0" styleClass="content-area">
        <HBox styleClass="topbar" alignment="CENTER_LEFT">
            <VBox>
                <Label text="Revision Dashboard" styleClass="screen-title"/>
                <Label text="Track learning retention and revision progress" styleClass="screen-subtitle"/>
            </VBox>
        </HBox>

        <VBox spacing="20" style="-fx-padding: 28;" VBox.vgrow="ALWAYS">
            <!-- Stats Badges -->
            <HBox spacing="16">
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER">
                    <Label text="Mastered" style="-fx-text-fill: #6ee7b7; -fx-font-weight: bold;"/>
                    <Label fx:id="masteredCountLabel" text="0" styleClass="card-number" style="-fx-text-fill: #10b981;"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER">
                    <Label text="Strong" style="-fx-text-fill: #93c5fd; -fx-font-weight: bold;"/>
                    <Label fx:id="strongCountLabel" text="0" styleClass="card-number"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER">
                    <Label text="Needs Revision" style="-fx-text-fill: #fca5a5; -fx-font-weight: bold;"/>
                    <Label fx:id="needsRevisionCountLabel" text="0" styleClass="card-number" style="-fx-text-fill: #ef4444;"/>
                </VBox>
            </HBox>

            <!-- Revision Table -->
            <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                <Label text="All Revision Records" styleClass="card-title"/>
                <TableView fx:id="revisionTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="topicColumn" text="Topic" prefWidth="200"/>
                        <TableColumn fx:id="documentColumn" text="Document" prefWidth="160"/>
                        <TableColumn fx:id="scoreColumn" text="Retention" prefWidth="90"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                        <TableColumn fx:id="countColumn" text="Reviews" prefWidth="90"/>
                        <TableColumn fx:id="lastReviewedColumn" text="Last Reviewed" prefWidth="160"/>
                    </columns>
                </TableView>
                <HBox spacing="12">
                    <Button text="✅ Mark Selected as Revised" onAction="#handleMarkSelectedRevised" styleClass="btn-success"/>
                    <Button text="📝 Take Quiz" onAction="#handleTakeQuizForSelected" styleClass="btn-primary"/>
                    <Button text="📄 View Notes" onAction="#handleViewNotesForSelected" styleClass="btn-secondary"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</HBox>
