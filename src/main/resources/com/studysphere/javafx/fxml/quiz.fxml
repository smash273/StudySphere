<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studysphere.javafx.controller.QuizController" style="-fx-background-color: #0b1120;">

    <!-- Sidebar -->
    <VBox prefWidth="220" spacing="4" styleClass="sidebar">
        <Label text="StudySphere" styleClass="brand-title"/>
        <Label text="Learning Platform" styleClass="brand-subtitle"/>
        <Button text="📊  Dashboard" styleClass="nav-button" maxWidth="Infinity" onAction="#handleBackToDashboard"/>
        <Button text="📤  Upload Material" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToUpload"/>
        <Button text="📝  View Notes" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToNotes"/>
        <Button text="💬  Ask My Notes" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToAskNotes"/>
        <Button text="🔄  Revision" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToRevision"/>
        <Button text="🎓  CSE1007 Demo" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToCSE1007"/>
        <Button text="⚙  Settings" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToSettings"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Button text="🚪  Logout" styleClass="nav-button" maxWidth="Infinity" onAction="#handleLogout"/>
    </VBox>

    <!-- Content -->
    <VBox HBox.hgrow="ALWAYS" spacing="0" styleClass="content-area">
        <HBox styleClass="topbar" spacing="16" alignment="CENTER_LEFT">
            <VBox>
                <Label text="Revision Quiz" styleClass="screen-title"/>
                <Label text="Test your knowledge on extracted topics" styleClass="screen-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="topicSelector" promptText="Select Topic" prefWidth="260"/>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="16" style="-fx-padding: 28;">
                <Label fx:id="topicTitleLabel" text="Select a topic to begin" styleClass="screen-title"/>
                <VBox fx:id="questionsContainer" spacing="14"/>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Button fx:id="submitButton" text="Submit Answers" onAction="#handleSubmitQuiz"
                            styleClass="btn-success" style="-fx-padding: 14 32 14 32;"/>
                    <Label fx:id="resultScoreLabel" text="" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #38bdf8;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
