<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studysphere.javafx.controller.UploadController" style="-fx-background-color: #0b1120;">

    <!-- Sidebar -->
    <VBox prefWidth="220" spacing="4" styleClass="sidebar">
        <Label text="StudySphere" styleClass="brand-title"/>
        <Label text="Learning Platform" styleClass="brand-subtitle"/>
        <Button text="📊  Dashboard" styleClass="nav-button" maxWidth="Infinity" onAction="#handleBackToDashboard"/>
        <Button text="📤  Upload Material" styleClass="nav-button-active,nav-button" maxWidth="Infinity"/>
        <Button text="📝  View Notes" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToNotes"/>
        <Button text="💬  Ask My Notes" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToAskNotes"/>
        <Button text="🔄  Revision" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToRevision"/>
        <Button text="🎓  CSE1007 Demo" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToCSE1007"/>
        <Button text="⚙  Settings" styleClass="nav-button" maxWidth="Infinity" onAction="#handleGoToSettings"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Button text="🚪  Logout" styleClass="nav-button" maxWidth="Infinity" onAction="#handleLogout"/>
    </VBox>

    <!-- Content -->
    <VBox HBox.hgrow="ALWAYS" spacing="0" styleClass="content-area">
        <HBox styleClass="topbar" alignment="CENTER_LEFT">
            <VBox>
                <Label text="Upload Study Material" styleClass="screen-title"/>
                <Label text="Upload PDF, DOCX, or TXT files for AI-powered analysis" styleClass="screen-subtitle"/>
            </VBox>
        </HBox>

        <VBox spacing="20" style="-fx-padding: 28;" alignment="TOP_CENTER">
            <VBox styleClass="card" maxWidth="600" spacing="16">
                <Label text="Document Details" styleClass="card-title"/>

                <Label text="Title (optional — auto-detected from filename)" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                <TextField fx:id="titleField" promptText="e.g. Operating Systems Chapter 3"/>

                <Label text="Select File" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button fx:id="selectFileButton" text="Browse Files..." onAction="#handleSelectFile" styleClass="btn-secondary"/>
                    <Label fx:id="selectedFileLabel" text="No file selected" style="-fx-text-fill: #64748b;"/>
                </HBox>

                <Button fx:id="uploadButton" text="Upload &amp; Analyze with AI" onAction="#handleUploadAndProcess"
                        styleClass="btn-primary" maxWidth="Infinity" style="-fx-padding: 14 0 14 0;"/>
                <Button fx:id="cancelButton" text="Cancel" styleClass="btn-secondary" maxWidth="Infinity" visible="false"/>

                <!-- Progress Section -->
                <VBox spacing="8" alignment="CENTER">
                    <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity" prefHeight="18"/>
                    <HBox spacing="12" alignment="CENTER">
                        <Label fx:id="progressLabel" text="0%" style="-fx-text-fill: #38bdf8; -fx-font-weight: bold;"/>
                        <Label fx:id="stageDescriptionLabel" text="" style="-fx-text-fill: #94a3b8;"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </VBox>
</HBox>
