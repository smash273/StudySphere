# StudySphere Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Database Configuration (PostgreSQL 18)
DB_URL=jdbc:postgresql://localhost:5432/studysphere
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# AI Service Configuration
# Providers: fallback (deterministic offline mode), openai, gemini
AI_PROVIDER=fallback
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# File Upload Settings
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=25

# Concurrency Settings
THREAD_POOL_SIZE=4
CHUNK_SIZE_WORDS=600
CHUNK_OVERLAP_WORDS=100
